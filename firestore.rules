rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 선생님 본인(uid 일치) 여부 확인
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    // 1. 학생 데이터 (학생 목록 및 집계된 태그 횟수)
    match /students/{studentId} {
      allow get: if isOwner(resource.data.teacherUid);
      allow list: if isAuthenticated() && (
        // 쿼리 필터에 teacherUid가 본인인 경우만 허용
        resource.data.teacherUid == request.auth.uid
      );
      
      allow create: if isOwner(request.resource.data.teacherUid);
      allow update: if isOwner(resource.data.teacherUid)
                    && (request.resource.data.teacherUid == resource.data.teacherUid);
      allow delete: if isOwner(resource.data.teacherUid);
    }

    // 2. 관찰 기록 일지 데이터
    match /observations/{obsId} {
      allow get: if isOwner(resource.data.teacherUid);
      allow list: if isAuthenticated() && (
        resource.data.teacherUid == request.auth.uid
      );
      
      allow create: if isOwner(request.resource.data.teacherUid);
      allow delete: if isOwner(resource.data.teacherUid);
      // 기록은 수정 불가
      allow update: if false;
    }

    // 3. 선생님 개인 설정 데이터
    match /teachers/{teacherUid} {
      allow read, write: if request.auth != null && request.auth.uid == teacherUid;
    }
  }
}

